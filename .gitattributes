# ------------------------------------------------------------
# Line endings
#
# Shell scripts and container config MUST use LF. A CRLF shebang
# breaks the interpreter inside Linux containers:
#
#   bash: ./bao-cli.sh: /usr/bin/env^M: bad interpreter
# ------------------------------------------------------------

* text=auto eol=lf

*.sh        text eol=lf
*.hcl       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
.env        text eol=lf
.env.*      text eol=lf
Dockerfile  text eol=lf

*.md        text eol=lf

# ------------------------------------------------------------
# Binary - never normalize
# ------------------------------------------------------------

*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.jks       binary
*.p12       binary
