# ============================================================
# CMN Local Development / Public Demo Configuration
# ============================================================
#
# SAFE FOR PUBLIC REPOSITORY
#
# All passwords, tokens, encryption keys, API credentials and
# other credentials in this file are intentionally fake demo
# values. They MUST NOT be used in production.
#
# For real local development, copy this file to .env and replace
# credentials with local-only values where required.
#
# ============================================================

SPRING_PROFILES_ACTIVE=dev


# ------------------------------------------------------------
# Postgres
# One server, one DB, one schema per service
# ------------------------------------------------------------

POSTGRES_DB=cmn_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=demo-postgres-password

AUTH_POSTGRES_USER=authuser
AUTH_POSTGRES_PASSWORD=demo-auth-postgres-password

SUBSCRIPTION_POSTGRES_USER=subscriptionuser
SUBSCRIPTION_POSTGRES_PASSWORD=demo-subscription-postgres-password

EMAIL_POSTGRES_USER=emailuser
EMAIL_POSTGRES_PASSWORD=demo-email-postgres-password

# cmn-workflow-svc owns the vendored Flowable engine schema.
WORKFLOW_POSTGRES_USER=workflowuser
WORKFLOW_POSTGRES_PASSWORD=demo-workflow-postgres-password


# ------------------------------------------------------------
# cmn-auth-svc
# ------------------------------------------------------------

AUTH_ISSUER_URI=http://localhost:9081

# No front-end application configured in this standalone demo.
ACM_FRONT_APP_SIGNIN_URL=


# ------------------------------------------------------------
# Token signing keys
# ------------------------------------------------------------

# Optional PEM-encoded RSA keypair.
# Empty in public demo; application generates a development keypair.
AUTH_JWK_PRIVATE_KEY_PEM=
AUTH_JWK_PUBLIC_KEY_PEM=
AUTH_JWK_GENERATED_KEY_PATH=


# ------------------------------------------------------------
# MFA / Federation encryption
# ------------------------------------------------------------

# DEMO ONLY - not a real production encryption key.
AUTH_MFA_ENCRYPTION_KEY=ZGVtby1tZmEtaW5jcnlwdGlvbi1rZXktMjAyNi0wMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAw

# DEMO ONLY - not a real production encryption key.
AUTH_FEDERATION_ENCRYPTION_KEY=ZGVtby1mZWRlcmF0aW9uLWVuY3J5cHRpb24ta2V5LTIwMjYtMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAw


# ------------------------------------------------------------
# Bootstrap OAuth client
# ------------------------------------------------------------

# DEMO ONLY.
AUTH_BOOTSTRAP_CLIENT_SECRET=demo-bootstrap-client-secret


# ------------------------------------------------------------
# LDAP / Federation
# ------------------------------------------------------------

# DEMO ONLY.
LDAP_ADMIN_PASSWORD=demo-ldap-admin-password

AUTH_LDAP_URL=ldap://openldap:1389
AUTH_LDAP_BASE_DN=dc=example,dc=org
AUTH_LDAP_MANAGER_DN=cn=admin,dc=example,dc=org
AUTH_LDAP_USER_SEARCH_BASE=ou=users
AUTH_LDAP_USER_SEARCH_FILTER=(cn={0})
AUTH_LDAP_EMAIL_ATTRIBUTE=mail


# ------------------------------------------------------------
# CORS / WebAuthn
# ------------------------------------------------------------

AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

AUTH_WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001


# ------------------------------------------------------------
# Google reCAPTCHA
# ------------------------------------------------------------

# Empty in public demo.
AUTH_RECAPTCHA_SECRET_KEY=


# ------------------------------------------------------------
# Browser Session / BFF
# ------------------------------------------------------------

# DEMO ONLY.
AUTH_BFF_SESSION_ENCRYPTION_KEY=ZGVtby1iZmYtc2Vzc2lvbi1lbmNyeXB0aW9uLWtleS0yMDI2LTAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAw

AUTH_BFF_COOKIE_DOMAIN=

AUTH_BFF_PROXY_SERVICES=auth,workflow,subscription,email

AUTH_BFF_PROXY_AUTH_ALLOWED=GET /api/v1/auth/users/me,GET /api/v1/auth/sessions,DELETE /api/v1/auth/sessions/*,POST /api/v1/auth/sessions/revoke-all,GET /api/v1/auth/tenant/memberships,PUT /api/v1/auth/password,GET /api/v1/auth/mfa/status,POST /api/v1/auth/mfa/setup,POST /api/v1/auth/mfa/enable,POST /api/v1/auth/mfa/disable,GET /api/v1/auth/mfa/webauthn/credentials,DELETE /api/v1/auth/mfa/webauthn/credentials/*,POST /api/v1/auth/mfa/webauthn/register/begin,POST /api/v1/auth/mfa/webauthn/register/finish,POST /api/v1/auth/otp/request,POST /api/v1/auth/otp/verify,POST /api/v1/auth/phone-verification/request,POST /api/v1/auth/phone-verification/verify,GET /api/v1/admin/clients,POST /api/v1/admin/clients,DELETE /api/v1/admin/clients/*,GET /api/v1/admin/users,POST /api/v1/admin/tenants/invites,POST /api/v1/auth/user-files,GET /api/v1/auth/user-files,GET /api/v1/auth/user-files/*,GET /api/v1/auth/user-files/*/content,DELETE /api/v1/auth/user-files/*,GET /api/v1/admin/federation-providers,POST /api/v1/admin/federation-providers,PUT /api/v1/admin/federation-providers/*,DELETE /api/v1/admin/federation-providers/*

AUTH_BFF_PROXY_WORKFLOW_BASE_URL=http://cmn-workflow-svc:8080

AUTH_BFF_PROXY_WORKFLOW_ALLOWED=GET /api/v1/tasks,GET /api/v1/tasks/*,POST /api/v1/tasks/*/claim,POST /api/v1/tasks/*/submit

AUTH_BFF_PROXY_SUBSCRIPTION_BASE_URL=http://cmn-subscription-svc:8080

AUTH_BFF_PROXY_SUBSCRIPTION_ALLOWED=GET /api/v1/usage-events,GET /api/v1/usage-entitlements,GET /api/v1/meter-readings

AUTH_BFF_PROXY_EMAIL_BASE_URL=http://cmn-email-svc:8080

AUTH_BFF_PROXY_EMAIL_ALLOWED=POST /api/v1/campaigns,GET /api/v1/campaigns/*,POST /api/v1/campaigns/*/launch,POST /api/v1/campaigns/*/send-to-segment,GET /api/v1/incidents,GET /api/v1/incidents/*,GET /api/v1/incidents/*/plan-items,GET /api/v1/incidents/case-model,POST /api/v1/subscribers/import/csv,GET /api/v1/subscribers,GET /api/v1/templates,GET /api/v1/templates/*,POST /api/v1/templates,PUT /api/v1/templates/*,DELETE /api/v1/templates/*,GET /api/v1/workflow-trace/sent-items,GET /api/v1/workflow-trace/sent-items/*


# ------------------------------------------------------------
# Email delivery
# ------------------------------------------------------------

# Local Mailpit container.
AUTH_SMTP_HOST=mailpit
AUTH_SMTP_PORT=1025

# Empty for local Mailpit.
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=

AUTH_SMTP_FROM=no-reply@cmn-auth-svc.local


# ------------------------------------------------------------
# cmn-subscription-svc
# ------------------------------------------------------------

AUTH_JWK_SET_URI=http://cmn-auth-svc:8080/oauth2/jwks

SUBSCRIPTION_USAGE_AGGREGATION_CRON=0 */15 * * * *


# ------------------------------------------------------------
# Payment gateways
# ------------------------------------------------------------

# Empty demo values keep external payment adapters disabled.

SUBSCRIPTION_STRIPE_SECRET_KEY=
SUBSCRIPTION_STRIPE_WEBHOOK_SECRET=

SUBSCRIPTION_PAYPAL_CLIENT_ID=
SUBSCRIPTION_PAYPAL_CLIENT_SECRET=
SUBSCRIPTION_PAYPAL_WEBHOOK_ID=
SUBSCRIPTION_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

SUBSCRIPTION_BRAINTREE_MERCHANT_ID=
SUBSCRIPTION_BRAINTREE_PUBLIC_KEY=
SUBSCRIPTION_BRAINTREE_PRIVATE_KEY=
SUBSCRIPTION_BRAINTREE_ENVIRONMENT=sandbox


# ------------------------------------------------------------
# cmn-workflow-svc / cmn-email-svc
# ------------------------------------------------------------

# DEMO ONLY - shared service JWT secret.
WORKFLOW_JWT_SECRET=demo-workflow-jwt-secret

WORKFLOW_CORS_ALLOWED_ORIGINS=http://localhost:3000

# OAuth client used by workflow service to communicate with auth.
# DEMO ONLY.
WORKFLOW_AUTH_CLIENT_ID=cmn-workflow-svc
WORKFLOW_AUTH_CLIENT_SECRET=demo-workflow-client-secret


# ------------------------------------------------------------
# Flowable
# ------------------------------------------------------------

# DEMO ONLY.
FLOWABLE_ADMIN_USER=admin
FLOWABLE_ADMIN_PASSWORD=demo-flowable-password


# ------------------------------------------------------------
# Email relay
# ------------------------------------------------------------

# Local/demo configuration only.
RELAY_USER=demo-relay-user
RELAY_PASSWORD=demo-relay-password


# ------------------------------------------------------------
# cmn-app-gw
# ------------------------------------------------------------

GW_AUTH_BASE_URL=http://cmn-auth-svc:8080
GW_SUBSCRIPTION_BASE_URL=http://cmn-subscription-svc:8080
GW_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001


# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------

# DEMO ONLY.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=demo-grafana-password


# ------------------------------------------------------------
# Elasticsearch / Kibana
# ------------------------------------------------------------

# DEMO ONLY.
ELASTIC_PASSWORD=demo-elastic-password

# DEMO ONLY.
KIBANA_SYSTEM_PASSWORD=demo-kibana-system-password

KIBANA_ADMIN_USER=admin
KIBANA_ADMIN_PASSWORD=demo-kibana-password


# ------------------------------------------------------------
# MinIO
# ------------------------------------------------------------

# DEMO ONLY.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=demo-minio-password


# ------------------------------------------------------------
# Email authentication client
# ------------------------------------------------------------

EMAIL_AUTH_CLIENT_ID=cmn-email-svc

# DEMO ONLY.
EMAIL_AUTH_CLIENT_SECRET=demo-email-client-secret
